# Copy to .env in the repository root. Never commit .env.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=tg_parser
PG_CONNECT_TIMEOUT=5

REQUEST_TIMEOUT=20
SCRAPE_WORKERS=4
SCRAPE_REQUEST_INTERVAL=1.0
MAX_PAGES=5
MIN_CHANNEL_SUBSCRIBERS=1000

# Optional; leave empty for public HTML metadata refresh.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=atlas_backup_account
TG_EXPECTED_USER_ID=
TG_PROXY_HOST=
TG_PROXY_PORT=
TGSTAT_API_TOKEN=
