flowchart TB
    INPUT["Каналы после классификации"] --> MODE{"Группировка"}
    MODE -->|"По темам"| TOPIC["Архипелаг = тема; остров = географическое соседство"]
    MODE -->|"По регионам"| GEO["Архипелаг = регион; остров = тема"]
    TOPIC --> SCATTER["Детерминированное облако: seed от ID, проверка расстояний через сетку"]
    GEO --> SCATTER
    SCATTER --> PLACE{"Режим размещения архипелагов"}
    PLACE -->|"темы"| PACK["Свободная радиальная упаковка; промежутки между островами"]
    PLACE -->|"регионы"| ANCHOR["Центры регионов → проекция Ламберта → раздвижение коллизий"]
    ANCHOR --> GUTTER["Каналы без координат и федеральные группы: отдельная область снизу"]
    PACK --> LAYOUT["Координаты точек, группы, контуры и подписи"]
    GUTTER --> LAYOUT
    LAYOUT --> CANVAS["Canvas: точки, рельеф и подписи по масштабу"]
    FILTER["Поиск, категория, охват, регион, страна"] -->|"видимость ID; координаты сохраняются"| CANVAS
    ZOOM["Масштаб и перетаскивание"] -->|"меняется камера"| CANVAS
    CANVAS --> HIT["Пространственный индекс: наведение / клик"]
    HIT --> CARD["Карточка и объяснение классификации"]
    CARD -->|"ручная смена темы"| REBUILD["Пересчитать классификацию и раскладку"]
    REBUILD --> INPUT
    classDef data fill:#e5edf8,stroke:#6981a0,color:#1b304e
    classDef check fill:#fff4d9,stroke:#b49a55,color:#463b1d
    classDef warn fill:#fce9e5,stroke:#ad756c,color:#5a2b24
    class LAYOUT data
    class MODE,PLACE check
